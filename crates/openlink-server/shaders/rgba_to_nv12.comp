#version 450
// Both eyes of a compositor frame -> one side-by-side NV12 frame (BT.709, limited range).
// One invocation per luma sample; a 16x16 group covers 8x8 chroma samples, averaged through
// shared memory. (One invocation per 2x2 block ran its texture reads one pixel after another:
// with a filter of dozens of reads per pixel, a quarter of the parallelism.)

layout(local_size_x = 16, local_size_y = 16) in;

shared vec3 block[16][16];

layout(set = 0, binding = 0) uniform sampler2D left_eye;
layout(set = 0, binding = 1) uniform sampler2D right_eye;
layout(set = 0, binding = 2, r8) uniform writeonly image2D y_plane;
layout(set = 0, binding = 3, rg8) uniform writeonly image2D cbcr_plane;
// SteamVR's own layer (dashboard, laser, overlays) drawn over an application's layer.
layout(set = 0, binding = 4) uniform sampler2D overlay_left;
layout(set = 0, binding = 5) uniform sampler2D overlay_right;

layout(push_constant) uniform Push {
    // uMin, vMin, uMax, vMax of each eye's image within its texture.
    vec4 bounds[2];
    // The same for SteamVR's overlay layer; all zero without one.
    vec4 overlay_bounds[2];
    // Output pixels per eye; the frame is two of these side by side, then black padding up to
    // the coded size.
    ivec2 eye_size;
    // Foveated encoding (openlink_protocol::foveation), mirrored from Foveation::to_full, in
    // pixels: the full-resolution and encoded eye size, the band length (0: not foveated) and,
    // per eye, where the band starts (full x, encoded x, full y, encoded y). The encoded size
    // is the one the parameters were made for; eye_size differs from it only if the encoder
    // could not fit it and the picture was scaled down.
    vec2 fov_full;
    vec2 fov_coded;
    vec2 fov_band;
    vec4 fov_start[2];
} pc;

// Growth of the encoded pixel size along a side e full and l encoded pixels long.
float growth(float e, float l) {
    return 2.0 * max(e - l, 0.0) / max(l * l, 0.25);
}

// One axis of the inverse warp, in pixels. g: position in the encoded eye; full, coded: the
// eye's lengths; band: the band's length; b0, c0: where it starts (full, encoded). Returns the
// full-resolution position and, in width, how many full pixels one encoded pixel covers there
// (1 in the band, up to the edge scale at the image edges).
float unfoveate(float g, float full, float coded, float band, float b0, float c0, out float width) {
    if (g < c0) {
        float a = growth(b0, c0);
        float d = c0 - g;
        width = 1.0 + a * d;
        return b0 - (d + 0.5 * a * d * d);
    }
    if (g > c0 + band) {
        float a = growth(full - b0 - band, coded - c0 - band);
        float d = g - c0 - band;
        width = 1.0 + a * d;
        return b0 + band + d + 0.5 * a * d * d;
    }
    width = 1.0;
    return b0 + g - c0;
}

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// Taps per axis at most: a footprint of up to 3 source texels per output pixel gets the full
// kernel (a 1.8x supersampled Quest 3 eye into the panel size is 2.8); beyond that (the far
// edges of a foveated picture, or more supersampling) it is narrower than the footprint.
const int MAX_TAPS = 12;

// Lanczos-2. A Catmull-Rom cubic was tried as a cheaper kernel: no faster (the texture reads
// dominate, not the sines) and slightly softer.
float lanczos2(float x) {
    x = abs(x);
    if (x < 1e-4) return 1.0;
    if (x >= 2.0) return 0.0;
    float a = 3.14159265 * x;
    return 2.0 * sin(a) * sin(0.5 * a) / (a * a);
}

const int MAX_PAIRS = MAX_TAPS / 2;

// Lanczos-2 weights of texels lo + 2k and lo + 2k + 1 along one axis, folded into one bilinear
// tap each: where in the pair to sample (0..1, texel units past the first) and the pair's total
// weight. Exact when both weights have the same sign; a pair across the kernel's zero crossing
// (both weights small there) is sampled at its larger weight.
void pair_weights(float center, float scale, int lo, int pairs, out float offset[MAX_PAIRS], out float weight[MAX_PAIRS]) {
    for (int k = 0; k < pairs; k++) {
        float w0 = lanczos2((float(lo + 2 * k) - center) / scale);
        float w1 = lanczos2((float(lo + 2 * k + 1) - center) / scale);
        float w = w0 + w1;
        weight[k] = w;
        offset[k] = (w0 * w1 > 0.0) ? w1 / w : (abs(w1) > abs(w0) ? 1.0 : 0.0);
    }
}

// Below this many source texels per output pixel the kernel changes sign within a texel or
// two, so paired taps would mostly straddle zero crossings: read texels directly (few anyway).
// On a zone plate at 1.5x, pairs cost 4 dB against FFmpeg's Lanczos; at 2.8x nothing.
const float PAIR_FROM = 2.0;

// The colour at `uv` of a texture, filtered for an output pixel `footprint` (in UV) wide and
// high: Lanczos-2 scaled to the footprint (never narrower than one texel), on texel centres.
// Separable. With a large footprint each bilinear fetch covers a pair of texels on both axes:
// a quarter of the reads, which is what makes this affordable (a 1.8x supersampled Quest 3 eye
// into the panel size: 3.9 ms for both eyes on an RX 6800, against 11.7 reading every texel).
vec3 resample(sampler2D tex, vec2 uv, vec2 footprint) {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 center = uv * size - 0.5;
    vec2 scale = clamp(footprint * size, vec2(1.0), vec2(float(MAX_TAPS) / 4.0));
    ivec2 lo = ivec2(floor(center - 2.0 * scale)) + 1;
    ivec2 hi = ivec2(floor(center + 2.0 * scale));
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    if (min(scale.x, scale.y) < PAIR_FROM) {
        int nx = min(hi.x - lo.x + 1, MAX_TAPS);
        int ny = min(hi.y - lo.y + 1, MAX_TAPS);
        float wx[MAX_TAPS];
        float wsum_x = 0.0;
        for (int i = 0; i < nx; i++) {
            wx[i] = lanczos2((float(lo.x + i) - center.x) / scale.x);
            wsum_x += wx[i];
        }
        ivec2 last = ivec2(size) - 1;
        for (int j = 0; j < ny; j++) {
            float wy = lanczos2((float(lo.y + j) - center.y) / scale.y);
            int y = clamp(lo.y + j, 0, last.y);
            vec3 row = vec3(0.0);
            for (int i = 0; i < nx; i++) {
                row += wx[i] * texelFetch(tex, ivec2(clamp(lo.x + i, 0, last.x), y), 0).rgb;
            }
            sum += wy * row;
            wsum += wy * wsum_x;
        }
    } else {
        int px = min((hi.x - lo.x + 2) / 2, MAX_PAIRS);
        int py = min((hi.y - lo.y + 2) / 2, MAX_PAIRS);
        float ox[MAX_PAIRS], wx[MAX_PAIRS], oy[MAX_PAIRS], wy[MAX_PAIRS];
        pair_weights(center.x, scale.x, lo.x, px, ox, wx);
        pair_weights(center.y, scale.y, lo.y, py, oy, wy);
        float wsum_x = 0.0;
        for (int i = 0; i < px; i++) wsum_x += wx[i];
        for (int j = 0; j < py; j++) {
            // The pair's first texel centre is lo + 0.5; the bilinear tap sits `offset` further.
            float v = (float(lo.y + 2 * j) + 0.5 + oy[j]) / size.y;
            vec3 row = vec3(0.0);
            for (int i = 0; i < px; i++) {
                float u = (float(lo.x + 2 * i) + 0.5 + ox[i]) / size.x;
                row += wx[i] * textureLod(tex, vec2(u, v), 0.0).rgb;
            }
            sum += wy[j] * row;
            wsum += wy[j] * wsum_x;
        }
    }
    // The negative lobes can overshoot at hard edges.
    return clamp(sum / wsum, 0.0, 1.0);
}

vec3 sample_frame(ivec2 p) {
    if (p.x >= 2 * pc.eye_size.x || p.y >= pc.eye_size.y) {
        return vec3(0.0);
    }
    int eye = p.x >= pc.eye_size.x ? 1 : 0;
    vec2 local = (vec2(p.x - eye * pc.eye_size.x, p.y) + 0.5) / vec2(pc.eye_size);
    // Size of this output pixel within the eye, as a fraction of the eye.
    vec2 px = 1.0 / vec2(pc.eye_size);
    if (pc.fov_band.x > 0.0) {
        vec4 s = pc.fov_start[eye];
        vec2 g = local * pc.fov_coded;
        vec2 width;
        vec2 x = vec2(unfoveate(g.x, pc.fov_full.x, pc.fov_coded.x, pc.fov_band.x, s.x, s.y, width.x),
                      unfoveate(g.y, pc.fov_full.y, pc.fov_coded.y, pc.fov_band.y, s.z, s.w, width.y));
        local = x / pc.fov_full;
        px = width * pc.fov_coded / (vec2(pc.eye_size) * pc.fov_full);
    }
    vec4 b = pc.bounds[eye];
    vec2 uv = mix(b.xy, b.zw, local);
    // The eye textures are larger than the output (SteamVR supersamples, and foveation squeezes
    // the edges further), so each output pixel covers several source texels. They are combined
    // with a Lanczos-2 filter stretched over that footprint: it keeps the detail the output can
    // hold and removes what it cannot (which would alias as shimmer). Four bilinear taps over
    // the footprint, as before, measured against FFmpeg's Lanczos on a zone plate (5710 ->
    // 2064 wide): visibly softer, mid-to-high frequencies faded to grey, 26 dB apart.
    vec3 c = eye == 0 ? resample(left_eye, uv, (b.zw - b.xy) * px) : resample(right_eye, uv, (b.zw - b.xy) * px);
    vec4 ob = pc.overlay_bounds[eye];
    if (any(notEqual(ob, vec4(0.0)))) {
        vec2 ouv = mix(ob.xy, ob.zw, local);
        vec4 o = eye == 0 ? textureLod(overlay_left, ouv, 0.0) : textureLod(overlay_right, ouv, 0.0);
        c = mix(c, o.rgb, o.a);
    }
    return c;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    ivec2 size = imageSize(y_plane);
    vec3 rgb = vec3(0.0);
    if (p.x < size.x && p.y < size.y) {
        rgb = sample_frame(p);
        imageStore(y_plane, p, vec4((16.0 + 219.0 * dot(rgb, LUMA)) / 255.0));
    }
    block[l.y][l.x] = rgb;
    barrier();
    if ((l.x & 1) != 0 || (l.y & 1) != 0) {
        return;
    }
    ivec2 c = p / 2;
    ivec2 csize = imageSize(cbcr_plane);
    if (c.x >= csize.x || c.y >= csize.y) {
        return;
    }
    vec3 avg = 0.25 * (block[l.y][l.x] + block[l.y][l.x + 1] + block[l.y + 1][l.x] + block[l.y + 1][l.x + 1]);
    float y = dot(avg, LUMA);
    float cb = (avg.b - y) / 1.8556;
    float cr = (avg.r - y) / 1.5748;
    imageStore(cbcr_plane, c, vec4((128.0 + 224.0 * cb) / 255.0, (128.0 + 224.0 * cr) / 255.0, 0.0, 0.0));
}
